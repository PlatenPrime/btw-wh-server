{
  "name": "btw-wh-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:mongod:repair": "node --import tsx src/test/scripts/repairMongodBinary.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "ci": "npm run format:check && npm run lint && npm run test:run && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@clerk/express": "^2.1.85",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.4.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "css-what": "^8.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "https-proxy-agent": "^9.1.0",
    "impit": "^0.14.7",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "playwright": "^1.64.1",
    "svix": "^2.9.1",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "mongodb-memory-server": true
  }
}
